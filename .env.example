# Required Supabase connection
SUPABASE_URL=
# Set one Supabase key value.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_KEY=

# Live pytest creates, updates, and deletes a temporary row; set to 0 to disable.
RUN_SUPABASE_LIVE_TESTS=1

# Optional application configuration
SUPABASE_TABLE=incidents
OPENROUTER_API_KEY=
LLM_MODEL_NAME=openai/gpt-oss-20b:free
LLM_TIMEOUT_SECONDS=6.0
PDF_OCR_WORKERS=8

# Optional free-tier Roboflow image inference
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=fire-detection-data-pre/4
ROBOFLOW_PERSON_MODEL_ID=yolov8n-640
# Object-detection endpoint. Override only when using a compatible deployment.
ROBOFLOW_API_URL=https://detect.roboflow.com

# Local OpenAI Whisper speech-to-text
WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=en
WHISPER_MODEL_DIR=
WHISPER_BEAM_SIZE=5

# OCR
TESSERACT_CMD=

# Video object detection speed/quality tradeoff
VIDEO_YOLO_DEVICE=auto
VIDEO_YOLO_SAMPLE_STRIDE=4
VIDEO_YOLO_IMAGE_SIZE=320
VIDEO_YOLO_MODEL_PATH=video/yolov8s.pt
