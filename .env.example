# Required Supabase connection
SUPABASE_URL=
SUPABASE_KEY=

# Live pytest creates, updates, and deletes a temporary row; set to 0 to disable.
RUN_SUPABASE_LIVE_TESTS=1

# Optional application configuration
SUPABASE_TABLE=incidents
OPENROUTER_API_KEY=
LLM_MODEL_NAME=
LLM_TIMEOUT_SECONDS=30
ENABLE_OCR_FALLBACK=false
FAST_DEMO_MODE=true

# Optional free-tier Roboflow image inference
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=fire-detection-data-pre/4
# Object-detection endpoint. Override only when using a compatible deployment.
ROBOFLOW_API_URL=https://detect.roboflow.com

# Local OpenAI Whisper speech-to-text
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en
WHISPER_MODEL_DIR=
