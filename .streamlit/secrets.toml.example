# Streamlit Community Cloud secrets template.
# Copy these into the app's "Secrets" box when deploying (Manage app → Settings
# → Secrets), or save a local copy as .streamlit/secrets.toml (do NOT commit the
# real one). Python dependencies use the conda env named
# multimodal-incident-analyzer; local secret values can still live in the
# project-root .env file.

SUPABASE_URL = "https://<your-project>.supabase.co"
SUPABASE_KEY = "your-supabase-publishable-or-anon-key"
